app_id = 'dev.nawashiro.paperphone'

install_data(
  app_id + '.desktop',
  install_dir: get_option('datadir') / 'applications',
)

install_data(
  app_id + '.metainfo.xml',
  install_dir: get_option('datadir') / 'metainfo',
)

install_data(
  app_id + '.png',
  install_dir: get_option('datadir') / 'icons' / 'hicolor' / '192x192' / 'apps',
)
