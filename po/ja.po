#: src/paperphone/main.py
msgid "Create, preview, save, and print your paper booklet."
msgstr "紙の冊子を作成して、プレビュー・保存・印刷します。"

#: src/paperphone/main.py
msgid "GNOME startup foundation"
msgstr "GNOME版の起動基盤"

#: src/paperphone/main.py
msgid "Start preparing"
msgstr "準備を始める"

#: src/paperphone/main.py
msgid "Startup check complete."
msgstr "起動を確認しました。"

#: src/paperphone/contact_selection.py
msgid "Select up to 7 contacts."
msgstr "印刷する連絡先を7件まで選択できます。"

#: src/paperphone/contact_selection.py
msgid "You can select up to 7 contacts."
msgstr "連絡先は7件まで選択できます。"

#: src/paperphone/contact_selection.py
msgid "No contacts with phone numbers are available."
msgstr "電話番号がある連絡先はありません。"

