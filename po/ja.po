msgid "Today"
msgstr "今日"

#: src/paperphone/todo_selection.py
msgid "Upcoming"
msgstr "今後"

#: src/paperphone/todo_selection.py
msgid "No due date"
msgstr "期限なし"

#: src/paperphone/todo_selection.py
msgid "No tasks in this category."
msgstr "この分類にタスクはありません。"

#: src/paperphone/todo_selection.py
msgid "Untitled task"
msgstr "無題のタスク"

#: src/paperphone/todo_selection.py
msgid "Starts: {when}"
msgstr "着手: {when}"

#: src/paperphone/todo_selection.py
msgid "Due: {when}"
msgstr "期限: {when}"

#: src/paperphone/todo_selection.py
msgid "Overdue"
msgstr "期限切れ"

#: src/paperphone/refresh_view.py
msgid "Refresh selected sources"
msgstr "選択したデータソースを更新"

#: src/paperphone/refresh_view.py
msgid "Cancel"
msgstr "キャンセル"

#: src/paperphone/refresh_view.py
msgid "Not refreshed yet."
msgstr "まだ更新していません。"

#: src/paperphone/refresh_view.py
msgid "Reading selected sources…"
msgstr "選択したデータソースを読み込み中…"

#: src/paperphone/refresh_view.py
msgid "Refresh could not be started."
msgstr "更新を開始できませんでした。"

#: src/paperphone/refresh_view.py
msgid "Refresh cancelled."
msgstr "更新をキャンセルしました。"

#: src/paperphone/refresh_view.py
msgid "Some sources could not be read."
msgstr "読み取れないデータソースがあります。"

#: src/paperphone/refresh_view.py
msgid "Refresh complete."
msgstr "更新が完了しました。"

#: src/paperphone/refresh_view.py
msgid "CalDAV changes were not confirmed. Cached tasks may be shown."
msgstr "CalDAVの変更を確認できませんでした。保存済みのタスクが表示される場合があります。"

